// Win32 version resource for the KinectNavigator shim (ships as Kinect10.dll).
// Numbers come from version.h. Gives the unsigned DLL real "Details" metadata
// and lets the installer compare the installed copy against the one it bundles.

#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    KN_VER_MAJOR,KN_VER_MINOR,KN_VER_PATCH,KN_VER_BUILD
 PRODUCTVERSION KN_VER_MAJOR,KN_VER_MINOR,KN_VER_PATCH,KN_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "VenB304"
            VALUE "FileDescription",  "KinectNavigator - hands-free Kinect menu navigation for Just Dance Legacy Offline PC"
            VALUE "FileVersion",      KN_VER_STRING
            VALUE "InternalName",     "KinectNavigator"
            VALUE "LegalCopyright",   "MIT License. Copyright (c) 2026 VenB304"
            VALUE "OriginalFilename", "Kinect10.dll"
            VALUE "ProductName",      "KinectNavigator"
            VALUE "ProductVersion",   KN_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
