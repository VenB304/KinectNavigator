# Normalise line endings: LF in the repo, native on checkout.
* text=auto

*.cpp    text
*.h      text
*.def    text
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.md     text
*.ini    text
*.html   text
*.py     text
*.sln    text eol=crlf
*.vcxproj text eol=crlf

*.skcap  binary
*.dll    binary
*.pdb    binary
*.png    binary
